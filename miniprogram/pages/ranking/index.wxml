<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else><view class="section-title">已提交排名</view><empty-state wx:if="{{!ranking.length}}" title="还没有人提交"/><view wx:for="{{ranking}}" wx:key="userId" class="card rank-row"><view class="rank">{{item.rank}}</view><view class="person"><view>{{item.nickname}}</view><view class="subtitle">{{item.submittedAt}}<text wx:if="{{item.timing === 'overdue'}}" class="overdue"> · 逾期</text></view></view><view class="score">{{item.score}}</view></view><view class="section-title">未完成（{{unfinished.length}}）</view><empty-state wx:if="{{!unfinished.length}}" title="所有 Member 均已完成"/><view wx:for="{{unfinished}}" wx:key="userId" class="card row-between"><text>{{item.nickname}}</text><text class="tag tag-warning">{{item.stage}}</text></view><view class="subtitle note">Owner 不参与排名和未完成统计</view></view></view>
