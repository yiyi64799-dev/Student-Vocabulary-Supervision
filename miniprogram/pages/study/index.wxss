.study{min-height:calc(100vh - 100rpx);display:flex;flex-direction:column;gap:32rpx;padding-bottom:env(safe-area-inset-bottom)}.study>view:first-child{padding:10rpx 4rpx;color:#66816d;font-size:25rpx}.flashcard{position:relative;display:flex;flex:1;flex-direction:column;align-items:center;justify-content:center;min-height:520rpx;padding:60rpx 36rpx;background:#fffefa;border:1rpx solid #e5e7dc;border-radius:32rpx;box-shadow:0 14rpx 40rpx #294c3710;text-align:center;overflow-wrap:anywhere}.flashcard::before{content:'WORD CARD / 单词记忆';font-size:19rpx;letter-spacing:3rpx;color:#9aa58b;margin-bottom:48rpx}.word{font-size:64rpx;font-weight:700;font-family:Georgia,serif;color:#28513e}.phonetic{margin-top:14rpx;color:#8a9689;font-size:28rpx}.meaning{margin-top:38rpx;font-size:36rpx}.example{margin-top:30rpx;padding-top:26rpx;border-top:1rpx solid #e9ecdf;color:#76826e;font-size:27rpx;font-style:italic;line-height:1.8}.controls{padding-top:10rpx}.controls button{flex:1;margin:0;font-size:26rpx}
