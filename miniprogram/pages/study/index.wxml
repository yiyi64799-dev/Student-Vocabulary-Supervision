<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else class="study"><view><view class="row-between"><text>{{index + 1}} / {{words.length}}</text><text>{{percent}}%</text></view><progress-bar value="{{percent}}"/></view><view class="flashcard"><view class="word">{{words[index].word}}</view><view wx:if="{{words[index].phonetic}}" class="phonetic">{{words[index].phonetic}}</view><view class="meaning">{{words[index].meaning}}</view><view wx:if="{{words[index].example}}" class="example">{{words[index].example}}</view></view><view class="row controls"><button class="button-secondary" disabled="{{index === 0}}" bindtap="previous">上一个</button><button wx:if="{{hasNextWord}}" class="button-primary" bindtap="next">下一个</button><button wx:else class="button-primary" loading="{{completing}}" disabled="{{completing}}" bindtap="complete">完成记忆并默写</button></view></view></view>
