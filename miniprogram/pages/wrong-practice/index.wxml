<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><empty-state wx:elif="{{state === 'empty'}}" title="没有错词" description="本次正式默写全部正确"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:elif="{{result}}" class="card done"><view class="title">本轮 {{result.score}} 分</view><view>{{result.correctCount}} / {{result.totalCount}} 正确</view><view class="subtitle">正式成绩保持不变</view><button class="button-primary" bindtap="load">再练一轮</button></view><view wx:else class="practice"><view class="row-between"><text>{{index + 1}} / {{order.length}}</text><text class="tag">错词练习</text></view><view class="question"><view class="prompt">{{wordsById[order[index]].meaning}}</view><input class="answer" placeholder="输入英文单词" value="{{answers[order[index]]}}" bindinput="onAnswer"/></view><view class="stack"><view class="row controls"><button class="button-secondary" disabled="{{index === 0}}" bindtap="previous">上一题</button><button class="button-primary" disabled="{{index === order.length - 1}}" bindtap="next">下一题</button></view><button class="button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交本轮练习</button></view></view></view>
