<view class="page stack"><view class="card"><view class="card-title">从表格复制并粘贴</view><view class="subtitle">支持 TAB、竖线或逗号分隔。第一列为英文单词，第二列为释义。V1 不解析 .xlsx 文件。</view><textarea class="paste" placeholder="apple&#9;苹果&#10;banana | 香蕉" value="{{text}}" bindinput="onText"></textarea><button class="button-primary" loading="{{parsing}}" disabled="{{parsing}}" bindtap="parse">解析并预览</button></view>
<view wx:if="{{preview}}"><view class="card row-between"><text>有效 {{preview.validCount}}</text><text>错误 {{preview.errorCount}}</text><text>重复 {{preview.duplicateCount}}</text></view><view wx:if="{{preview.issues.length}}" class="card"><view class="card-title">需处理的行</view><view wx:for="{{preview.issues}}" wx:key="line" class="issue">第 {{item.line}} 行：{{item.message}}<text class="raw">{{item.raw}}</text></view></view><view class="section-title">有效内容</view><view wx:for="{{preview.validRows}}" wx:key="index" class="card row-between"><view><view>{{item.word}}</view><view class="subtitle">{{item.meaning}}</view></view><text class="remove" data-index="{{index}}" bindtap="removeRow">删除</text></view><button class="button-primary" disabled="{{preview.errorCount > 0 || !preview.validRows.length}}" bindtap="confirm">确认加入任务</button></view></view>
