<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><empty-state wx:elif="{{state === 'empty'}}" title="暂无成员"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else><view wx:for="{{members}}" wx:key="userId" class="card row-between"><view class="row"><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><view wx:else class="avatar placeholder">{{item.initial}}</view><view><view>{{item.nickname}}</view><view class="subtitle">加入于 {{item.joinedAt}}</view></view></view><view class="tag">{{item.role}}</view></view></view></view>
