<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else class="stack"><view class="card"><view class="row-between"><view><view class="title small">{{task.title}}</view><view class="subtitle">{{task.wordCount}} 个单词 · 截止 {{task.deadline}}</view></view><view class="tag {{task.status === 'withdrawn' ? 'tag-danger' : ''}}">{{task.status}}</view></view></view>
<view wx:if="{{isSubmitted}}" class="card result"><score-badge score="{{progress.score}}" overdue="{{progress.timing === 'overdue'}}"/><view>{{progress.correctCount}} / {{progress.totalCount}} 正确</view><button class="button-primary" bindtap="openResult">查看正式成绩</button></view>
<view wx:elif="{{isWithdrawn}}" class="card"><view class="card-title">任务已撤回</view><view class="subtitle">无法开始新的学习或正式默写。</view></view>
<button wx:elif="{{isReadyForDictation}}" class="button-primary" bindtap="startDictation">开始正式默写</button><button wx:else class="button-primary" bindtap="startStudy">{{studyButtonText}}</button><button class="button-secondary" bindtap="openRanking">查看排行榜</button></view></view>
