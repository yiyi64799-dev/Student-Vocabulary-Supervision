<view class="page"><view class="preview-banner">教师预览 · 不保存学习进度，不产生正式成绩，不参与排行榜。退出后体验数据清空。</view>
<loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="card"><view>无法预览，请确认任务已发布且未撤回，并且属于您管理的小组。</view><button class="button-secondary" bindtap="load">重试</button></view><view wx:elif="{{state === 'empty'}}" class="card">暂无可预览的单词</view>
<view wx:else><view class="section-title">{{title}}</view>
<block wx:if="{{phase !== 'result'}}"><view class="subtitle">{{phase === 'memory' ? '词卡记忆' : practice ? '错词重练体验' : '默写体验'}} · {{index + 1}} / {{words.length}}</view>
<view class="card word-card"><block wx:if="{{phase === 'memory'}}"><view class="word">{{current.word}}</view><view class="subtitle">{{current.phonetic}}</view></block><view class="meaning">{{current.meaning}}</view><view wx:if="{{phase === 'memory'}}" class="subtitle">{{current.example}}</view><input wx:else class="field" placeholder="输入英文单词" maxlength="100" value="{{answer}}" bindinput="onAnswer"/></view>
<view class="row"><button class="button-secondary" disabled="{{index === 0}}" bindtap="previous">上一个</button><button class="button-primary" disabled="{{index + 1 >= words.length}}" bindtap="next">下一个</button></view>
<view class="stack"><button wx:if="{{phase === 'memory' && index + 1 === words.length}}" class="button-primary" bindtap="startDictation">完成记忆，体验默写</button><button wx:if="{{phase === 'dictation'}}" class="button-primary" bindtap="submit">查看体验结果（不提交正式成绩）</button></view></block>
<view wx:else><view class="card"><view class="subtitle">{{practice ? '本轮练习体验分数' : '默写体验分数'}} · 仅本地演示</view><view class="preview-score">{{score}}</view></view><view wx:for="{{items}}" wx:key="index" class="card"><view class="tag {{item.correct ? '' : 'tag-danger'}}">{{item.correct ? '正确' : '需复习'}}</view><view class="meaning">{{item.meaning}}</view><view class="answer-line">你的答案：{{item.answer || '未作答'}}</view><view class="answer-line">正确答案：{{item.word}}</view></view><view class="stack"><button class="button-primary" bindtap="practiceWrong">体验错词重练</button><button class="button-secondary" bindtap="load">重新体验完整任务</button></view></view></view><view class="safe-bottom"/></view>
