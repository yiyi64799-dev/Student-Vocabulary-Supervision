<view class="page"><view class="card stack profile"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"><image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image><view class="subtitle">点击选择头像</view></button><label><text class="label">昵称</text><input class="field" type="nickname" maxlength="30" value="{{nickname}}" bindinput="onNickname"/></label><button class="button-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存资料</button></view>
<view class="card stack"><view class="card-title">{{isTeacher ? '教师账号' : '学生账号'}}</view><view class="subtitle">学生使用小组邀请码加入学习；教师开通码仅用于开通教学工作台。</view>
<button wx:if="{{isTeacher}}" class="button-primary" bindtap="openTeacher">进入教学工作台</button>
<block wx:else><input class="field" password maxlength="64" placeholder="输入管理员提供的教师开通码" value="{{code}}" bindinput="onCode"/><button class="button-secondary" loading="{{activating}}" disabled="{{activating || !code}}" bindtap="activate">开通教师身份</button></block></view></view>
