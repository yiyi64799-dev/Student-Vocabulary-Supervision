.summary{text-align:center;display:flex;flex-direction:column;gap:18rpx;background:#edf2e7;padding:38rpx 24rpx}.summary::before{content:'YOUR PROGRESS / 正式成绩';font-size:20rpx;letter-spacing:2rpx;color:#819371}.summary button{margin-top:12rpx}.answer-row{border-left:6rpx solid #90ae82}.answer-row.wrong{border-left-color:#d6a264}.mark{font-size:42rpx;font-weight:700}.correct .mark{color:#6c9563}.wrong .mark{color:#ba7e43}.mine{margin-top:20rpx;padding:16rpx 20rpx;border-radius:12rpx;background:#f5f6ef;font-size:26rpx}.answer-row .card-title{font-size:30rpx}.answer-row .subtitle{font-size:25rpx}
