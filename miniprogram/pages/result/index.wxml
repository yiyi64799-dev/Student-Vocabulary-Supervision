<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else><view class="card summary"><score-badge score="{{submission.score}}" overdue="{{submission.timing === 'overdue'}}"/><view>{{submission.correctCount}} / {{submission.totalCount}} 正确</view><view class="subtitle">提交于 {{submittedLabel}}</view><button wx:if="{{canPractice}}" class="button-primary" bindtap="practice">重新练习错词</button></view><view class="row-between section-title"><text>逐题明细</text><button size="mini" class="button-secondary" bindtap="toggleWrong">{{onlyWrong ? '查看全部' : '只看错词'}}</button></view><empty-state wx:if="{{onlyWrong && !visibleItems.length}}" title="这次没有错词" description="继续保持，下一次也认真完成"/><view wx:for="{{visibleItems}}" wx:key="wordId" class="card answer-row {{item.isCorrect ? 'correct' : 'wrong'}}"><view class="row-between"><view><view class="card-title">{{item.word.meaning}}</view><view class="subtitle">正确答案：{{item.word.word}}</view></view><view class="mark">{{item.isCorrect ? '✓' : '×'}}</view></view><view class="mine">我的答案：{{item.answer || '（未作答）'}}</view></view></view></view>
