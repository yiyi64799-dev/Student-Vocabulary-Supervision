<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else class="stack">
<view class="card stack"><label><text class="label">任务标题</text><input class="field" maxlength="40" placeholder="例如：Unit 1 单词默写" value="{{title}}" bindinput="onTitle"/></label><view><text class="label">截止时间</text><view class="row"><picker class="picker" mode="date" value="{{date}}" bindchange="onDate"><view class="field">{{date}}</view></picker><picker class="picker" mode="time" value="{{time}}" bindchange="onTime"><view class="field">{{time}}</view></picker></view></view></view>
<view class="row-between"><view class="section-title">单词（{{words.length}}/200）</view><view class="row"><button size="mini" class="button-secondary" bindtap="openImport">粘贴导入</button><button size="mini" class="button-primary" bindtap="addWord">添加</button></view></view>
<empty-state wx:if="{{!words.length}}" title="还没有单词" description="手动添加，或从 Excel/WPS 复制两列后粘贴"/>
<view wx:for="{{words}}" wx:key="index" class="card word"><view class="row-between"><text class="index">#{{index + 1}}</text><text class="remove" data-index="{{index}}" bindtap="removeWord">删除</text></view><input class="field" placeholder="英文单词" value="{{item.word}}" data-index="{{index}}" data-field="word" bindinput="updateWord"/><input class="field" placeholder="释义" value="{{item.meaning}}" data-index="{{index}}" data-field="meaning" bindinput="updateWord"/><input class="field" placeholder="音标（可选）" value="{{item.phonetic}}" data-index="{{index}}" data-field="phonetic" bindinput="updateWord"/><input class="field" placeholder="例句（可选）" value="{{item.example}}" data-index="{{index}}" data-field="example" bindinput="updateWord"/></view>
<view class="row sticky"><button class="button-secondary" loading="{{saving}}" disabled="{{saving || publishing}}" bindtap="save">保存草稿</button><button class="button-primary" loading="{{publishing}}" disabled="{{saving || publishing}}" bindtap="publish">发布任务</button></view><view class="safe-bottom"></view></view></view>
