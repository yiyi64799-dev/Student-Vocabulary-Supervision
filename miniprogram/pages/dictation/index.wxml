<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">无法开始默写，点击重试</view><view wx:else class="dictation"><view><view class="row-between"><text>{{index + 1}} / {{order.length}}</text><text>{{percent}}%</text></view><progress-bar value="{{percent}}"/></view><view class="question"><view class="prompt">{{wordsById[order[index]].meaning}}</view><view wx:if="{{wordsById[order[index]].example}}" class="example">{{wordsById[order[index]].example}}</view><input class="answer" placeholder="输入英文单词" value="{{answers[order[index]]}}" bindinput="onAnswer" focus="{{true}}" confirm-type="next"/></view><view class="stack"><view class="row controls"><button class="button-secondary" disabled="{{index === 0}}" bindtap="previous">上一题</button><button class="button-primary" disabled="{{index === order.length - 1}}" bindtap="next">下一题</button></view><button class="button-danger" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">一次性提交正式答案</button></view></view></view>
