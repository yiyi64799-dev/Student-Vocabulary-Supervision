.dictation{min-height:calc(100vh - 100rpx);display:flex;flex-direction:column;justify-content:space-between;gap:32rpx;padding-bottom:env(safe-area-inset-bottom)}.dictation>view:first-child{color:#69836e;font-size:25rpx}.question{background:#fffefa;border:1rpx solid #e5e7dc;border-radius:30rpx;padding:48rpx 32rpx;text-align:center}.question::before{content:'RECALL / 主动回想';display:block;font-size:20rpx;letter-spacing:3rpx;color:#929e84;margin-bottom:30rpx}.prompt{font-size:42rpx;font-weight:650;overflow-wrap:anywhere}.example{margin:24rpx 0;color:#7f8b7c;font-size:26rpx;line-height:1.8}.answer{box-sizing:border-box;width:100%;height:110rpx;margin-top:38rpx;padding:18rpx;background:#f1f4ea;border:2rpx solid #cddbc5;border-radius:18rpx;font-size:34rpx}.controls button{flex:1;margin:0}.dictation .button-danger{background:#2a5742!important;color:#fff!important}
