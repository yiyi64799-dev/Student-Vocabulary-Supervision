<view class="page"><loading-state wx:if="{{state === 'loading'}}"/><view wx:elif="{{state === 'error'}}" class="error" bindtap="load">加载失败，点击重试</view><view wx:else>
<view class="card"><view class="row-between"><view><view class="title small">{{task.title}}</view><view class="subtitle">{{task.wordCount}} 个单词</view></view><view class="tag {{task.status === 'withdrawn' ? 'tag-danger' : ''}}">{{task.status}}</view></view></view>
<button wx:if="{{task.status === 'published'}}" class="button-secondary" bindtap="previewStudent">预览学生端（不计成绩）</button>
<view class="metrics"><view class="metric"><text class="value">{{stats.completionRate}}%</text><text>完成率</text></view><view class="metric"><text class="value">{{stats.completedCount}}/{{stats.memberCount}}</text><text>已完成</text></view><view class="metric"><text class="value">{{stats.averageScore === null ? '--' : stats.averageScore}}</text><text>平均分</text></view></view>
<view class="row buttons"><button class="button-secondary" bindtap="openRanking">查看排行榜</button><button wx:if="{{task.status === 'published'}}" class="button-danger" loading="{{withdrawing}}" disabled="{{withdrawing}}" bindtap="withdraw">撤回任务</button></view>
<view class="section-title">成员状态</view><empty-state wx:if="{{!stats.members.length}}" title="暂无 Member" description="Owner 不计入完成率、未完成名单和排行榜"/><view wx:for="{{stats.members}}" wx:key="userId" class="card row-between" data-userid="{{item.stage === 'submitted' ? item.userId : ''}}" bindtap="openResult"><view><view>{{item.nickname}}</view><view class="subtitle">{{item.stage === 'submitted' ? '已提交' : '未完成'}}<text wx:if="{{item.timing === 'overdue'}}"> · 逾期完成</text></view></view><view wx:if="{{item.stage === 'submitted'}}" class="score">{{item.score}} 分<view class="subtitle">错 {{item.wrongCount}} 词</view></view><view wx:else class="tag tag-warning">{{item.stage}}</view></view></view></view>
