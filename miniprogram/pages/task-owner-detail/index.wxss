.small{font-size:40rpx}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-bottom:24rpx}.metric{display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:24rpx 8rpx;background:#fff;border-radius:20rpx;color:#78857f;font-size:24rpx}.value{color:#176b4d;font-size:36rpx;font-weight:700}.buttons button{flex:1;margin:0}.score{text-align:right;color:#176b4d;font-weight:650}
.metric{background:#e9eedf;border:1rpx solid #dce5d1;padding:30rpx 8rpx}.value{font-size:40rpx;color:#385c3e}.small{font-size:36rpx}.buttons{margin:28rpx 0}.score{color:#547744}
