page { background: #f6f5f1; color: #203c36; font-size: 28rpx; line-height: 1.6; }
button { font-size: 28rpx; font-weight: 600; }
button::after { border: 0; }
button[disabled] { opacity: .48; }
input { min-height: 48rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx; }
.hero { padding: 24rpx 0 32rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.3; }
.subtitle { margin-top: 10rpx; color: #6d7c75; font-size: 27rpx; }
.card { margin-bottom: 24rpx; padding: 30rpx; background: #fff; border: 1rpx solid #e6eae3; border-radius: 28rpx; box-shadow: 0 6rpx 24rpx rgba(25, 70, 52, .035); }
.card-title { font-size: 34rpx; font-weight: 650; }
.muted { color: #78857f; }
.row { display: flex; align-items: center; gap: 16rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.stack { display: flex; flex-direction: column; gap: 20rpx; }
.button-primary { background: #176b4d !important; color: #fff !important; border-radius: 18rpx; }
.button-secondary { background: #e5f2ec !important; color: #176b4d !important; border-radius: 18rpx; }
.button-danger { background: #fff0ee !important; color: #b63b30 !important; border-radius: 18rpx; }
.field { width: 100%; box-sizing: border-box; padding: 22rpx 24rpx; background: #f7f9f8; border: 2rpx solid #e1e7e4; border-radius: 16rpx; }
input.field { height: 96rpx; min-height: 96rpx; padding: 0 24rpx; line-height: normal; flex-shrink: 0; }
textarea.field { min-height: 160rpx; line-height: 1.6; flex-shrink: 0; }
button { max-width: 100%; }
.label { display: block; margin-bottom: 10rpx; color: #4a5952; font-size: 26rpx; }
.section-title { margin: 32rpx 0 18rpx; font-size: 34rpx; font-weight: 650; }
.tag { display: inline-flex; padding: 6rpx 14rpx; background: #e9f3ef; color: #176b4d; border-radius: 999rpx; font-size: 23rpx; }
.tag-warning { background: #fff2d8; color: #9c6411; }
.tag-danger { background: #ffe8e5; color: #b63b30; }
.error { margin: 20rpx 0; color: #b63b30; }
.safe-bottom { height: calc(env(safe-area-inset-bottom) + 24rpx); }
